<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Dashboard — Repasse Olympikus</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<style>
  :root{
    --ink:#0E1726; --navy:#15233B; --slate:#5B6678; --mute:#8A93A3;
    --paper:#F6F7F9; --card:#FFFFFF; --line:#E7EAEF; --line-2:#EFF1F5;
    --ftw:#2836D4; --ftw-lite:#5B69E8; --ftw-ink:#FFFFFF;
  }
  [data-theme="dark"]{
    --ink:#E8EBF1; --navy:#D6DDEA; --slate:#9AA4B5; --mute:#828DA0;
    --paper:#0E131D; --card:#161B26; --line:#2A3242; --line-2:#222A37;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--paper);color:var(--ink);
    font-family:"Inter",system-ui,sans-serif;font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
  .wrap{max-width:1040px;margin:0 auto;padding:0 20px 64px}
  .num{font-variant-numeric:tabular-nums}

  /* topbar */
  .topbar{display:flex;align-items:center;gap:12px;padding:16px 0;border-bottom:1px solid var(--line);
    position:sticky;top:0;background:var(--paper);z-index:20;flex-wrap:wrap}
  .brand{display:flex;align-items:center;gap:12px;min-width:0}
  .cms-logo{width:42px;height:42px;border-radius:13px;flex:none;display:grid;place-items:center;
    background:linear-gradient(135deg,#5B69E8,#2836D4);color:#fff;font-family:"Space Grotesk",sans-serif;
    font-weight:700;font-size:14px;letter-spacing:.02em;box-shadow:0 4px 12px rgba(40,54,212,.25)}
  .brand-txt{display:flex;flex-direction:column;line-height:1.2;min-width:0}
  .brand-name{font-family:"Space Grotesk",sans-serif;font-weight:600;font-size:15px;color:var(--ink);letter-spacing:-.01em}
  .brand-sub{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--mute);font-weight:600}
  .topbar .spacer{flex:1}
  .btn{font-family:"Space Grotesk",sans-serif;font-weight:600;font-size:12.5px;cursor:pointer;
    border:1px solid var(--line);background:var(--card);color:var(--navy);border-radius:8px;padding:7px 12px;
    display:inline-flex;align-items:center;gap:6px;text-decoration:none}
  .btn:hover{border-color:#CBD2DC}
  .theme-btn{cursor:pointer;border:1px solid var(--line);background:var(--card);color:var(--navy);
    border-radius:8px;width:36px;height:36px;display:grid;place-items:center;padding:0;flex:none}
  .theme-btn:hover{border-color:#CBD2DC}
  .periodo-bar{display:inline-flex;border:1px solid var(--line);border-radius:999px;background:var(--card);padding:3px;gap:2px}
  .periodo-btn{border:none;background:none;border-radius:999px;padding:6px 12px;font-family:"Space Grotesk",sans-serif;
    font-size:12px;font-weight:600;cursor:pointer;color:var(--slate);transition:all .12s}
  .periodo-btn.active{background:var(--ftw);color:var(--ftw-ink)}
  .refresh-spin{animation:spin .8s linear infinite}
  @keyframes spin{to{transform:rotate(360deg)}}

  /* hero */
  .hero{padding:20px 0 16px;display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap}
  .hero h1{font-family:"Space Grotesk",sans-serif;font-weight:700;font-size:clamp(18px,2.2vw,24px);
    letter-spacing:-.02em;margin:0}
  .hero .updated{font-size:12px;color:var(--mute)}

  /* KPIs compactos */
  .kpis{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:22px}
  .kpi{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px 12px;
    box-shadow:0 2px 10px rgba(40,54,212,.10);transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease}
  .kpi:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(40,54,212,.28);border-color:var(--ftw-lite)}
  .kpi-label{font-size:10px;font-weight:600;color:var(--mute);text-transform:uppercase;letter-spacing:.06em}
  .kpi-val{font-family:"Space Grotesk",sans-serif;font-size:20px;font-weight:700;margin-top:2px;color:var(--ftw)}

  /* blocos */
  .block{padding:18px 0}
  .block+.block{border-top:1px solid var(--line)}
  .block-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px;flex-wrap:wrap}
  .block-head h3{font-family:"Space Grotesk",sans-serif;font-size:12.5px;font-weight:600;letter-spacing:.12em;
    text-transform:uppercase;color:var(--mute);margin:0;display:flex;align-items:center;gap:10px}
  .block-head h3::after{content:"";flex:1;height:1px;background:var(--line);min-width:24px}
  .block-sub{font-size:12px;color:var(--mute)}
  .card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px 16px}

  /* ranking rows */
  .rank-row{display:flex;align-items:center;gap:12px;padding:12px 8px;border-radius:10px;cursor:pointer;
    transition:background .15s ease}
  .rank-row.row-alt{background:color-mix(in srgb, var(--ftw) 3.5%, transparent)}
  .rank-col-head{display:flex;align-items:center;gap:10px;padding:0 8px 8px;border-bottom:1px solid var(--line);
    margin-bottom:4px;
    font-family:"Space Grotesk",sans-serif;font-size:10.5px;font-weight:600;letter-spacing:.08em;
    text-transform:uppercase;color:var(--mute)}
  .rank-row:hover{background:color-mix(in srgb, var(--ftw) 10%, transparent)}
  .rank-pos{width:24px;height:24px;border-radius:50%;background:var(--line-2);color:var(--slate);
    font-family:"Space Grotesk",sans-serif;font-size:11px;font-weight:700;flex-shrink:0;
    display:flex;align-items:center;justify-content:center}
  .rank-row:first-child .rank-pos{background:linear-gradient(135deg, var(--ftw-lite), var(--ftw));color:#fff}
  .rank-avatar{width:38px;height:38px;border-radius:11px;background:linear-gradient(135deg, var(--ftw-lite), var(--ftw));
    color:#fff;font-family:"Space Grotesk",sans-serif;font-size:13px;font-weight:700;
    display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 3px 8px rgba(40,54,212,.32)}
  .rank-info{flex:1;min-width:0}
  .rank-name{font-size:14px;font-weight:700;color:var(--ink)}
  .rank-sub{font-size:11.5px;color:var(--mute);margin-top:2px}
  .rank-bar-wrap{width:72px;height:9px;background:var(--line-2);border-radius:999px;overflow:hidden;flex-shrink:0}
  .rank-bar{height:100%;border-radius:999px;background:linear-gradient(90deg, var(--ftw-lite), var(--ftw))}
  .rank-val{font-family:"Space Grotesk",sans-serif;font-size:17px;font-weight:700;color:var(--ftw);min-width:56px;text-align:right;flex-shrink:0}
  .btn-detalhe{width:28px;height:28px;border-radius:8px;border:1px solid var(--line);background:var(--card);
    color:var(--mute);display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;font-size:11px}
  .btn-detalhe:hover{border-color:#CBD2DC;color:var(--ink)}
  .btn-detalhe.open{background:var(--ftw);border-color:var(--ftw);color:#fff}
  .btn-detalhe.open i{transform:rotate(180deg)}
  .btn-detalhe i{transition:transform .15s}
  .expand-box{background:var(--line-2);border-radius:10px;padding:12px 14px;margin-top:10px;font-size:12.5px}
  .expand-box .row{display:flex;justify-content:space-between;padding:4px 0}
  .chip{display:inline-flex;align-items:center;gap:4px;border-radius:999px;padding:2px 9px;font-size:10.5px;font-weight:600}
  .chip-pend{background:color-mix(in srgb, #f59e0b 16%, transparent);color:#b45309}
  .chip-aprov{background:color-mix(in srgb, #22c55e 16%, transparent);color:#15803d}
  .chip-canc{background:color-mix(in srgb, #ef4444 16%, transparent);color:#b91c1c}
  .chip-off{background:var(--line-2);color:var(--mute)}
  .sit-ok{background:color-mix(in srgb, #22c55e 16%, transparent);color:#15803d}
  .sit-low{background:color-mix(in srgb, #f59e0b 16%, transparent);color:#b45309}
  .sit-crit{background:color-mix(in srgb, #ef4444 16%, transparent);color:#b91c1c}
  .badge-crit{background:color-mix(in srgb, #ef4444 16%, transparent);color:#991b1b}
  .badge-atenc{background:color-mix(in srgb, #f59e0b 16%, transparent);color:#92400e}
  .badge-ok{background:color-mix(in srgb, #22c55e 16%, transparent);color:#166534}
  .badge-venc{background:var(--line-2);color:var(--slate)}

  /* seletor de ordenação */
  .sort-select{font-family:"Space Grotesk",sans-serif;font-weight:600;font-size:12px;color:var(--slate);
    border:1px solid var(--line);background:var(--card);border-radius:8px;padding:6px 10px;cursor:pointer}
  .sort-select:hover{border-color:#CBD2DC}

  /* prazo */
  .prazo-row{display:flex;align-items:center;gap:14px;padding:11px 0;border-bottom:1px solid var(--line-2)}
  .prazo-row:last-child{border-bottom:none}
  .prazo-bar-wrap{width:100%;height:4px;background:var(--line-2);border-radius:999px;overflow:hidden;margin-top:6px}
  .prazo-bar{height:100%;border-radius:999px}
  .prazo-legend{display:flex;gap:12px;flex-wrap:wrap;font-size:11px;color:var(--mute)}
  .prazo-legend span{display:inline-flex;align-items:center;gap:5px}
  .dot{width:7px;height:7px;border-radius:50%;display:inline-block}

  .btn-ver-mais{width:100%;margin-top:10px;text-align:center;font-family:"Space Grotesk",sans-serif;
    font-size:12px;font-weight:600;color:var(--slate);background:none;border:1px dashed var(--line);
    border-radius:10px;padding:8px;cursor:pointer}
  .btn-ver-mais:hover{border-color:#CBD2DC;color:var(--ink)}

  .empty-msg{font-size:13px;color:var(--mute);text-align:center;padding:20px 0}
  .footer-note{text-align:center;font-size:11.5px;color:var(--mute);padding-top:8px}
  .hidden{display:none!important}
</style>
</head>
<body>
<div class="wrap">

  <div class="topbar">
    <div class="brand">
      <span class="cms-logo">CMS</span>
      <div class="brand-txt">
        <span class="brand-name">Dashboard de Repasses</span>
        <span class="brand-sub">Olympikus</span>
      </div>
    </div>
    <span class="spacer"></span>
    <a class="btn" href="https://cms-representacoes.github.io/apps-oly/">
      <i class="fa-solid fa-arrow-left"></i> Voltar ao Portal
    </a>
    <div class="periodo-bar">
      <button class="periodo-btn active" onclick="setPeriod('24h',this)">24h</button>
      <button class="periodo-btn" onclick="setPeriod('7d',this)">7 dias</button>
      <button class="periodo-btn" onclick="setPeriod('15d',this)">15 dias</button>
      <button class="periodo-btn" onclick="setPeriod('30d',this)">30 dias</button>
    </div>
    <button class="btn" id="btnRefresh" onclick="loadAll()">
      <i class="fa-solid fa-rotate" id="refreshIcon"></i> Atualizar
    </button>
    <button class="theme-btn" id="themeBtn" type="button" aria-label="Alternar tema claro/escuro"></button>
  </div>

  <div class="hero">
    <h1>Resumo de repasses</h1>
    <span class="updated" id="headerSub">Carregando...</span>
  </div>

  <!-- KPIs compactos -->
  <div class="kpis">
    <div class="kpi">
      <div class="kpi-label">Pares em estoque</div>
      <div class="kpi-val num" id="kSaldo">—</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">Pares repassados</div>
      <div class="kpi-val num" id="kAprovPares">—</div>
    </div>
  </div>

  <!-- RANKING DE VENDEDORES -->
  <div class="block">
    <div class="block-head">
      <h3>Vendedores</h3>
    </div>
    <div class="card">
      <div class="rank-col-head" style="gap:12px;padding-left:8px;padding-right:8px">
        <div style="width:38px;flex-shrink:0"></div>
        <div style="flex:1">Vendedor</div>
        <div style="width:72px;flex-shrink:0"></div>
        <div style="min-width:56px;text-align:right;flex-shrink:0">Pares</div>
        <div style="width:28px;flex-shrink:0"></div>
      </div>
      <div id="rankingList"></div>
    </div>
  </div>

  <!-- SALDO ATUAL EM ESTOQUE -->
  <div class="block">
    <div class="block-head">
      <h3>Saldo atual em estoque</h3>
      <select id="dispoSort" class="sort-select" onchange="reordenarDispo(this.value)">
        <option value="qtd_desc">Quantidade — maior primeiro</option>
        <option value="qtd_asc">Quantidade — menor primeiro</option>
        <option value="prazo_asc">Faturamento mais próximo</option>
        <option value="nome_asc">Nome do produto (A-Z)</option>
      </select>
    </div>
    <div class="card">
      <span class="block-sub" id="dispoCount" style="display:block;margin-bottom:10px"></span>
      <div id="dispoList"></div>
      <button class="btn-ver-mais hidden" id="btnMaisDispo" onclick="expandirDispo()">Ver mais produtos</button>
    </div>
  </div>

  <!-- PRODUTOS MAIS REPASSADOS -->
  <div class="block">
    <div class="block-head">
      <h3>Produtos mais repassados</h3>
      <span class="block-sub">pares aprovados no período</span>
    </div>
    <div class="card">
      <div class="rank-col-head" style="padding-left:8px;padding-right:8px">
        <div style="flex:1">Produto</div>
        <div style="min-width:56px;text-align:right;flex-shrink:0">Qtde</div>
      </div>
      <div id="produtosRankList"></div>
      <button class="btn-ver-mais hidden" id="btnMaisProdutos" onclick="expandirProdutos()">Ver mais produtos</button>
    </div>
  </div>

  <!-- PRODUTOS SEM PEDIDO — PRAZO (oculto a pedido do usuário; lógica mantida no
       código pra reativar rápido no futuro — só remover o style="display:none") -->
  <div class="block" id="blocoPrazo" style="display:none">
    <div class="block-head">
      <h3>Atenção ao prazo</h3>
      <span class="block-sub">Itens do estoque ainda sem pedido registrado</span>
    </div>
    <div class="card">
      <div class="prazo-legend" style="margin-bottom:10px">
        <span><span class="dot" style="background:#ef4444"></span>Crítico &lt;15 dias</span>
        <span><span class="dot" style="background:#f59e0b"></span>Atenção 15–30 dias</span>
        <span><span class="dot" style="background:#22c55e"></span>Tranquilo &gt;30 dias</span>
        <span><span class="dot" style="background:#94a3b8"></span>Vencido</span>
      </div>
      <div id="prazoLista"></div>
      <button class="btn-ver-mais hidden" id="btnMaisPrazo" onclick="expandirPrazo()">Ver todos</button>
    </div>
  </div>

  <div class="footer-note">Repasse Olympikus · Atualização automática a cada 60 segundos</div>
</div>

<script>
const WORKER_URL = 'https://repasse-worker-cms.marcosrep-cms.workers.dev';
const HOJE = new Date();
const TOP_N = 8;

let STATE = { orders:[], dispoRows:[], period:'24h' };
let produtosExpandido = false, prazoExpandido = false;
let ultimoProdutosRanking = [], ultimoPrazoLista = [];

// ── UTILS ─────────────────────────────────────────────────────────────────────
function fmt(n){ return Number(n||0).toLocaleString('pt-BR'); }
// Aceita "DD/MM/AAAA" (formato do dispo.json), serial do Excel, ou ISO —
// new Date("DD/MM/AAAA") direto dá data inválida em JS, por isso trata à parte.
function parseDataBR(v){
  if(!v) return null;
  const n=Number(v);
  if(!isNaN(n)&&n>40000&&n<60000){ const d=new Date(Date.UTC(1899,11,30)); d.setUTCDate(d.getUTCDate()+n); return d; }
  const str=String(v).trim();
  const br=str.match(/^(\d{1,2})\/(\d{1,2})\/(\d{2,4})$/);
  if(br){
    const [, dd, mm, aaaaRaw]=br;
    const aaaa=aaaaRaw.length===2?`20${aaaaRaw}`:aaaaRaw;
    const d=new Date(Number(aaaa), Number(mm)-1, Number(dd));
    return isNaN(d)?null:d;
  }
  const d=new Date(str);
  return isNaN(d)?null:d;
}
function fmtDate(v){
  const d=parseDataBR(v);
  return d?d.toLocaleDateString('pt-BR'):'—';
}
function canonicalStatus(s){
  const n=String(s||'').trim().toLowerCase();
  if(['aprovado','finalizado','faturado'].includes(n)) return 'Aprovado';
  if(['cancelado','cancelada'].includes(n)) return 'Cancelado';
  return 'Pendente';
}
function getItemUnits(item){
  if(!item) return 0;
  // totalUnits já vem calculado certo pelo vitrine.html (considera a quantidade
  // de caixas: amount × packSize). item.grade é só a distribuição de UMA caixa —
  // usar ele primeiro subestima o total quando o pedido tem mais de 1 caixa.
  const totalUnits = Number(item.totalUnits || 0);
  if(totalUnits > 0) return totalUnits;
  return (item.grade||[]).reduce((s,g)=>s+Number(g.qty||0),0);
}
function diasAte(dataStr){
  const d=parseDataBR(dataStr);
  if(!d) return 999;
  return Math.round((d-HOJE)/(1000*60*60*24));
}
function getStatusPrazo(dl){
  if(dl<0)  return{label:'Vencido',         cls:'badge-venc',cor:'#94a3b8'};
  if(dl<15) return{label:`${dl}d — Crítico`, cls:'badge-crit',cor:'#ef4444'};
  if(dl<=30)return{label:`${dl}d — Atenção`, cls:'badge-atenc',cor:'#f59e0b'};
  return      {label:`${dl}d — Tranquilo`,  cls:'badge-ok',  cor:'#22c55e'};
}
function iniciais(nome){
  return String(nome||'—').trim().split(/\s+/).slice(0,2).map(p=>p[0]).join('').toUpperCase();
}

// ── PERÍODO ───────────────────────────────────────────────────────────────────
function periodMs(p){
  return{
    '24h': 24*60*60*1000,
    '7d':  7*24*60*60*1000,
    '15d': 15*24*60*60*1000,
    '30d': 30*24*60*60*1000,
  }[p]||24*60*60*1000;
}
function ordersInPeriod(){
  const cutoff=Date.now()-periodMs(STATE.period);
  return STATE.orders.filter(o=>{
    const t=new Date(o.createdAt||o.updatedAt||0).getTime();
    return t>=cutoff;
  });
}

// ── LOAD ──────────────────────────────────────────────────────────────────────
async function loadAll(){
  const icon=document.getElementById('refreshIcon');
  icon.className='fa-solid fa-rotate refresh-spin';
  try{
    const [ordRes, dispoRes] = await Promise.all([
      fetch(`${WORKER_URL}?t=${Date.now()}`,{cache:'no-store'}),
      fetch(WORKER_URL,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'getDispo'}),cache:'no-store'})
    ]);
    if(ordRes.ok){ const d=await ordRes.json(); STATE.orders=Array.isArray(d)?d:(d.orders||[]); }
    if(dispoRes.ok){
      const d=await dispoRes.json();
      STATE.dispoRows=Array.isArray(d)?d:[];
    }
  }catch(e){ console.error(e); }
  icon.className='fa-solid fa-rotate';
  const now=new Date();
  document.getElementById('headerSub').textContent=`Atualizado às ${now.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})}`;
  render();
}

// ── RENDER ────────────────────────────────────────────────────────────────────
function render(){
  const orders=ordersInPeriod();
  const aprov=orders.filter(o=>canonicalStatus(o.status)==='Aprovado');
  const paresAprov=aprov.reduce((s,o)=>(o.items||[]).reduce((ss,i)=>ss+getItemUnits(i),s),0);

  document.getElementById('kAprovPares').textContent=fmt(paresAprov);

  // Saldo em estoque (todos os pedidos, não só o período — é foto do agora)
  const { pendMap, aprovMap } = buildDispoMaps();
  const saldoTotal=STATE.dispoRows.reduce((s,r)=>{
    const gci=String(r.gci||'').trim();
    const cod=String(r.codigo||'').trim();
    const key=gci||cod;
    const saldo=Number(r.saldo||0);
    const p=pendMap.get(key)||0, a=aprovMap.get(key)||0;
    return s+Math.max(0,saldo-p-a);
  },0);
  document.getElementById('kSaldo').textContent=fmt(saldoTotal);

  renderRanking(orders);
  renderProdutosRanking(aprov, buildSaldoLookup(pendMap, aprovMap));
  renderDispo(pendMap, aprovMap);
  renderPrazo();
}

function buildDispoMaps(){
  const pendMap=new Map(), aprovMap=new Map();
  for(const o of STATE.orders){
    const st=canonicalStatus(o.status);
    if(st==='Cancelado') continue;
    for(const item of (o.items||[])){
      const key=String(item.gci||item.codigo||'').trim();
      if(!key) continue;
      const u=getItemUnits(item);
      if(st==='Pendente') pendMap.set(key,(pendMap.get(key)||0)+u);
      else if(st==='Aprovado') aprovMap.set(key,(aprovMap.get(key)||0)+u);
    }
  }
  return{pendMap,aprovMap};
}

// ── RANKING DE VENDEDORES ───────────────────────────────────────────────────
function buildSaldoLookup(pendMap, aprovMap){
  const lookup=new Map(); // "produto|cor" normalizado → saldoReal
  for(const r of STATE.dispoRows){
    const gci=String(r.gci||'').trim();
    const cod=String(r.codigo||'').trim();
    const key=gci||cod;
    const saldo=Number(r.saldo||0);
    const p=pendMap.get(key)||0, a=aprovMap.get(key)||0;
    const saldoReal=saldo-p-a;
    const prodKey=`${String(r.produto||'').trim().toUpperCase()}|${String(r.cor||'').trim().toUpperCase()}`;
    lookup.set(prodKey, (lookup.get(prodKey)||0)+saldoReal);
  }
  return lookup;
}

let ultimoOrdersPeriodo = [];

function renderRanking(orders){
  ultimoOrdersPeriodo = orders;
  const PREPOSTOS=['JORGE','MARIANA','RAFAEL','WILLAME','LEANDRO','CHRISTIAN LUCAS','CMS'];
  const map=new Map();
  for(const o of orders){
    const nome=o.preposto?.nome||o.preposto?.codigo||'—';
    if(!map.has(nome)) map.set(nome,{pares:0,pedidos:0,aprov:0,pend:0,canc:0});
    const e=map.get(nome);
    const st=canonicalStatus(o.status);
    if(st==='Cancelado'){ e.canc++; continue; } // cancelado não conta no ranking
    e.pedidos++;
    if(st==='Aprovado') e.aprov++;
    else e.pend++;
    e.pares+=(o.items||[]).reduce((s,i)=>s+getItemUnits(i),0);
  }
  for(const p of PREPOSTOS){ if(!map.has(p)) map.set(p,{pares:0,pedidos:0,aprov:0,pend:0,canc:0}); }
  const sorted=[...map.entries()].sort((a,b)=>b[1].pares-a[1].pares);
  const maxPares=sorted[0]?.[1]?.pares||1;
  const comAtiv=sorted.filter(([,d])=>d.pedidos>0);

  document.getElementById('rankingList').innerHTML=comAtiv.map(([nome,d],i)=>{
    const pct=Math.round(d.pares/maxPares*100);
    const slotId=`vendSlot-${nome.replace(/[^A-Z0-9]/gi,'')}`;
    return`<div class="rank-row${i%2?' row-alt':''}" style="cursor:default">
      <div class="rank-avatar">${iniciais(nome)}</div>
      <div class="rank-info">
        <div class="rank-name">${nome}</div>
        <div class="rank-sub">${d.pedidos} pedido${d.pedidos!==1?'s':''} · ${fmt(d.pares)} pares</div>
      </div>
      <div class="rank-bar-wrap"><div class="rank-bar" style="width:${pct}%"></div></div>
      <div class="rank-val">${fmt(d.pares)}</div>
      <button class="btn-detalhe" onclick="toggleVendDetalhe('${safeAttr(nome)}','${slotId}')" title="Ver produtos e clientes deste vendedor">
        <i class="fa-solid fa-chevron-down"></i>
      </button>
    </div>
    <div class="vend-detail-slot hidden" id="${slotId}"></div>`;
  }).join('') || '<div class="empty-msg">Nenhum pedido no período.</div>';
}
function safeAttr(s){ return String(s).replace(/'/g,'&#39;').replace(/"/g,'&quot;'); }

function toggleVendDetalhe(nome, slotId){
  const slot=document.getElementById(slotId);
  const btn=document.querySelector(`.btn-detalhe[onclick*="${slotId}"]`);
  const jaAberto = slot.dataset.aberto==='1';

  // Fecha qualquer outro detalhe aberto antes de abrir este
  document.querySelectorAll('.vend-detail-slot').forEach(s=>{ s.classList.add('hidden'); s.dataset.aberto='0'; s.innerHTML=''; });
  document.querySelectorAll('.btn-detalhe.open').forEach(b=>b.classList.remove('open'));

  if(jaAberto) return; // só fechava
  slot.classList.remove('hidden');
  slot.dataset.aberto='1';
  if(btn) btn.classList.add('open');

  const doVendedor = ultimoOrdersPeriodo.filter(o => (o.preposto?.nome||o.preposto?.codigo||'—')===nome);
  const naoCancelados = doVendedor.filter(o => canonicalStatus(o.status)!=='Cancelado');
  const aprov = doVendedor.filter(o => canonicalStatus(o.status)==='Aprovado');
  const pend  = doVendedor.filter(o => canonicalStatus(o.status)==='Pendente');
  const pares = naoCancelados.reduce((s,o)=>(o.items||[]).reduce((ss,i)=>ss+getItemUnits(i),s),0);

  // Produtos repassados (pares aprovados, por produto+cor)
  const produtosMap=new Map();
  for(const o of aprov){
    for(const item of (o.items||[])){
      const produto=String(item.produto||'').trim(); if(!produto) continue;
      const cor=String(item.cor||'').trim();
      const key=`${produto}|${cor}`;
      const u=getItemUnits(item);
      produtosMap.set(key, (produtosMap.get(key)||0)+u);
    }
  }
  const topProdutos=[...produtosMap.entries()].sort((a,b)=>b[1]-a[1]).slice(0,5);

  // Clientes atendidos (todos os pedidos não cancelados)
  const clientesMap=new Map();
  for(const o of naoCancelados){
    const cli = o.clienteNome ? o.clienteNome : (o.clienteCodigo || 'Cliente não informado');
    if(!clientesMap.has(cli)) clientesMap.set(cli, {pedidos:0, pares:0});
    const c=clientesMap.get(cli);
    c.pedidos++;
    c.pares+=(o.items||[]).reduce((s,i)=>s+getItemUnits(i),0);
  }
  const topClientes=[...clientesMap.entries()].sort((a,b)=>b[1].pares-a[1].pares).slice(0,5);

  slot.innerHTML=`<div class="expand-box">
    <div class="row"><span style="color:var(--mute)">Total de pares</span><span style="font-weight:600;color:var(--ftw)">${fmt(pares)}</span></div>
    <div class="row"><span style="color:var(--mute)">Pedidos aprovados</span><span style="font-weight:600;color:#15803d">${aprov.length}</span></div>
    <div class="row"><span style="color:var(--mute)">Pedidos pendentes</span><span style="font-weight:600;color:#b45309">${pend.length}</span></div>

    <div style="font-weight:600;margin:12px 0 6px">Produtos repassados</div>
    ${topProdutos.length ? topProdutos.map(([k,v])=>{
      const [produto,cor]=k.split('|');
      return `<div class="row"><span>${produto}${cor?` · ${cor}`:''}</span><span style="font-weight:600;color:var(--ftw)">${fmt(v)} pares</span></div>`;
    }).join('') : '<div style="color:var(--mute)">Nenhum pedido aprovado ainda.</div>'}

    <div style="font-weight:600;margin:12px 0 6px">Clientes atendidos</div>
    ${topClientes.length ? topClientes.map(([nomeCli,c])=>
      `<div class="row"><span>${nomeCli}</span><span style="font-weight:600;color:var(--ftw)">${c.pedidos} pedido${c.pedidos!==1?'s':''} · ${fmt(c.pares)} pares</span></div>`
    ).join('') : '<div style="color:var(--mute)">Nenhum pedido no período.</div>'}
  </div>`;
}

// ── PRODUTOS MAIS REPASSADOS ─────────────────────────────────────────────────
function renderProdutosRanking(aprovOrders, saldoLookup){
  const map=new Map();
  for(const o of aprovOrders){
    for(const item of (o.items||[])){
      const produto=String(item.produto||'').trim();
      if(!produto) continue;
      const cor=String(item.cor||'').trim();
      const key=`${produto}|${cor}`;
      const u=getItemUnits(item);
      if(!map.has(key)) map.set(key,{produto,cor,pares:0});
      map.get(key).pares+=u;
    }
  }
  const sorted=[...map.values()].map(p=>{
    const lookupKey=`${p.produto.toUpperCase()}|${p.cor.toUpperCase()}`;
    return{ ...p, saldo: saldoLookup?.get(lookupKey) ?? null };
  }).sort((a,b)=>b.pares-a.pares);
  ultimoProdutosRanking = sorted;
  produtosExpandido = false;
  renderProdutosRankingLista();
}
function renderProdutosRankingLista(){
  const sorted = ultimoProdutosRanking;
  const lista = produtosExpandido ? sorted : sorted.slice(0, TOP_N);
  const max = sorted[0]?.pares || 1;
  document.getElementById('produtosRankList').innerHTML = lista.map((p,i)=>{
    const pct = Math.round(p.pares/max*100);
    const saldoTxt = p.saldo===null ? '—' : (p.saldo<=0 ? 'Esgotado' : `${fmt(p.saldo)} em estoque`);
    const saldoCls = p.saldo===null ? 'chip-off' : (p.saldo<=0 ? 'sit-crit' : (p.saldo<=12 ? 'sit-low' : 'sit-ok'));
    return`<div class="rank-row${i%2?' row-alt':''}" style="cursor:default">
      <div class="rank-info">
        <div class="rank-name">${p.produto}</div>
        <div class="rank-sub">${p.cor||'—'}</div>
      </div>
      <span class="chip ${saldoCls}" title="Saldo atual em estoque">${saldoTxt}</span>
      <div class="rank-bar-wrap"><div class="rank-bar" style="width:${pct}%"></div></div>
      <div class="rank-val">${fmt(p.pares)}</div>
    </div>`;
  }).join('') || '<div class="empty-msg">Nenhum pedido aprovado no período.</div>';

  const btn=document.getElementById('btnMaisProdutos');
  btn.classList.toggle('hidden', sorted.length<=TOP_N);
  btn.textContent = produtosExpandido ? 'Ver menos' : `Ver mais produtos (${sorted.length-TOP_N})`;
}
function expandirProdutos(){ produtosExpandido=!produtosExpandido; renderProdutosRankingLista(); }

// ── SALDO ATUAL EM ESTOQUE ───────────────────────────────────────────────────
let ultimoDispoLista = [];
let dispoExpandido = false;
let dispoSortAtual = 'qtd_desc';

function renderDispo(pendMap, aprovMap){
  const porCor=STATE.dispoRows.map(r=>{
    const gci=String(r.gci||'').trim();
    const cod=String(r.codigo||'').trim();
    const key=gci||cod;
    const saldo=Number(r.saldo||0);
    const p=pendMap.get(key)||0, a=aprovMap.get(key)||0;
    const saldoReal=saldo-p-a;
    return{
      produto:String(r.produto||'').trim(),
      cor:String(r.cor||'').trim(),
      gci:String(r.gci||'').trim(),
      saldoReal,
      prevFat:r.dataEntrega||null
    };
  }).filter(r=>r.produto);

  // Agrupa por produto (descrição) — as cores viram o detalhe, exibido ao clicar.
  const porProduto=new Map();
  for(const r of porCor){
    if(!porProduto.has(r.produto)) porProduto.set(r.produto, { produto:r.produto, saldoTotal:0, cores:[], prevFatMaisProxima:null });
    const g=porProduto.get(r.produto);
    g.saldoTotal+=r.saldoReal;
    g.cores.push({ cor:r.cor, gci:r.gci, prevFat:r.prevFat, saldoReal:r.saldoReal });
    const d=parseDataBR(r.prevFat);
    if(d && (!g.prevFatMaisProxima || d<g.prevFatMaisProxima)) g.prevFatMaisProxima=d;
  }

  ultimoDispoLista = [...porProduto.values()].filter(g => g.saldoTotal > 0);
  dispoExpandido = false;
  document.getElementById('dispoCount').textContent=`${ultimoDispoLista.length} produto${ultimoDispoLista.length!==1?'s':''}`;
  renderDispoLista();
}

function ordenarDispoLista(lista, modo){
  const arr=[...lista];
  if(modo==='qtd_asc')  arr.sort((a,b)=>a.saldoTotal-b.saldoTotal);
  else if(modo==='prazo_asc') arr.sort((a,b)=>{
    if(!a.prevFatMaisProxima && !b.prevFatMaisProxima) return 0;
    if(!a.prevFatMaisProxima) return 1;
    if(!b.prevFatMaisProxima) return -1;
    return a.prevFatMaisProxima-b.prevFatMaisProxima;
  });
  else if(modo==='nome_asc') arr.sort((a,b)=>a.produto.localeCompare(b.produto,'pt-BR'));
  else arr.sort((a,b)=>b.saldoTotal-a.saldoTotal); // qtd_desc (padrão)
  return arr;
}

function renderDispoLista(){
  const ordenada=ordenarDispoLista(ultimoDispoLista, dispoSortAtual);
  const lista = dispoExpandido ? ordenada : ordenada.slice(0, TOP_N);
  const max = ordenada[0]?.saldoTotal || 1;

  document.getElementById('dispoList').innerHTML = lista.map((p,i)=>{
    const pct = Math.max(2, Math.round(p.saldoTotal/max*100));
    const slotId=`dispoSlot-${i}-${p.produto.replace(/[^A-Z0-9]/gi,'')}`;
    return`<div class="rank-row${i%2?' row-alt':''}" style="cursor:default">
      <div class="rank-info">
        <div class="rank-name">${p.produto}</div>
        <div class="rank-sub">${new Set(p.cores.map(c=>c.cor)).size} cor${new Set(p.cores.map(c=>c.cor)).size!==1?'es':''}</div>
      </div>
      <div class="rank-bar-wrap"><div class="rank-bar" style="width:${pct}%"></div></div>
      <div class="rank-val">${fmt(p.saldoTotal)}</div>
      <button class="btn-detalhe" onclick="toggleDispoDetalhe('${slotId}', ${i})" title="Ver cores e quantidades">
        <i class="fa-solid fa-chevron-down"></i>
      </button>
    </div>
    <div class="vend-detail-slot hidden" id="${slotId}"></div>`;
  }).join('') || '<div class="empty-msg">Nenhum produto no estoque.</div>';

  const btn=document.getElementById('btnMaisDispo');
  btn.classList.toggle('hidden', ordenada.length<=TOP_N);
  btn.textContent = dispoExpandido ? 'Ver menos' : `Ver mais produtos (${ordenada.length-TOP_N})`;
}

function toggleDispoDetalhe(slotId, idx){
  const slot=document.getElementById(slotId);
  const btn=document.querySelector(`.btn-detalhe[onclick*="${slotId}"]`);
  const jaAberto = slot.dataset.aberto==='1';

  document.querySelectorAll('.vend-detail-slot').forEach(s=>{ s.classList.add('hidden'); s.dataset.aberto='0'; s.innerHTML=''; });
  document.querySelectorAll('.btn-detalhe.open').forEach(b=>b.classList.remove('open'));
  if(jaAberto) return;

  slot.classList.remove('hidden');
  slot.dataset.aberto='1';
  if(btn) btn.classList.add('open');

  const ordenada=ordenarDispoLista(ultimoDispoLista, dispoSortAtual);
  const lista = dispoExpandido ? ordenada : ordenada.slice(0, TOP_N);
  const produto = lista[idx];
  if(!produto) return;
  const cores=[...produto.cores].sort((a,b)=>b.saldoReal-a.saldoReal);

  slot.innerHTML=`<div class="expand-box">
    ${cores.map(c=>`<div class="row">
      <span>${c.cor||'—'}${c.gci?` · GCI ${c.gci}`:''}${c.prevFat?` · Prev. Fat. ${fmtDate(c.prevFat)}`:''}</span>
      <span style="font-weight:600;color:var(--ftw)">${fmt(c.saldoReal)} pares</span>
    </div>`).join('')}
  </div>`;
}

function reordenarDispo(modo){ dispoSortAtual=modo; dispoExpandido=false; renderDispoLista(); }
function expandirDispo(){ dispoExpandido=!dispoExpandido; renderDispoLista(); }

// ── ATENÇÃO AO PRAZO ─────────────────────────────────────────────────────────
function renderPrazo(){
  const gciComPedido=new Set();
  for(const o of STATE.orders){
    const st=canonicalStatus(o.status);
    if(st==='Cancelado') continue;
    for(const item of (o.items||[])){ gciComPedido.add(String(item.gci||item.codigo||'').trim()); }
  }
  const semPedido=STATE.dispoRows.filter(r=>{
    const gci=String(r.gci||'').trim();
    const cod=String(r.codigo||'').trim();
    return !gciComPedido.has(gci) && !gciComPedido.has(cod);
  }).map(r=>{
    const prevFat=r.dataEntrega||null;
    const diasPrevFat=diasAte(prevFat);
    const diasLimite=diasPrevFat-45;
    const status=getStatusPrazo(diasLimite);
    const limiteDate=parseDataBR(prevFat);
    if(limiteDate) limiteDate.setDate(limiteDate.getDate()-45);
    return{
      produto:String(r.produto||'').trim(),
      cor:String(r.cor||'').trim(),
      saldo:Number(r.saldo||0),
      prevStr:fmtDate(prevFat),
      limiteStr:limiteDate?limiteDate.toLocaleDateString('pt-BR'):'—',
      diasLimite, status
    };
  }).filter(r=>r.produto).sort((a,b)=>a.diasLimite-b.diasLimite);

  ultimoPrazoLista = semPedido;
  prazoExpandido = false;
  renderPrazoLista();
}
function renderPrazoLista(){
  const semPedido = ultimoPrazoLista;
  if(!semPedido.length){
    document.getElementById('prazoLista').innerHTML='<div class="empty-msg">Todos os itens do estoque possuem pedido registrado.</div>';
    document.getElementById('btnMaisPrazo').classList.add('hidden');
    return;
  }
  const lista = prazoExpandido ? semPedido : semPedido.slice(0, TOP_N);
  document.getElementById('prazoLista').innerHTML=lista.map(p=>{
    const pct=p.diasLimite<0?100:Math.max(5,Math.round((1-Math.min(p.diasLimite,90)/90)*100));
    return`<div class="prazo-row">
      <div style="flex:1;min-width:0">
        <div class="rank-name">${p.produto}</div>
        <div class="rank-sub">${p.cor} · ${fmt(p.saldo)} pares · Prev. Fat. ${p.prevStr}</div>
        <div class="prazo-bar-wrap"><div class="prazo-bar" style="width:${pct}%;background:${p.status.cor}"></div></div>
      </div>
      <div style="text-align:right;flex-shrink:0">
        <span class="chip ${p.status.cls}">${p.status.label}</span>
        <div style="font-size:10.5px;color:var(--mute);margin-top:4px">Limite: ${p.limiteStr}</div>
      </div>
    </div>`;
  }).join('');

  const btn=document.getElementById('btnMaisPrazo');
  btn.classList.toggle('hidden', semPedido.length<=TOP_N);
  btn.textContent = prazoExpandido ? 'Ver menos' : `Ver todos (${semPedido.length-TOP_N} a mais)`;
}
function expandirPrazo(){ prazoExpandido=!prazoExpandido; renderPrazoLista(); }

// ── INTERATIVIDADE ────────────────────────────────────────────────────────────
function setPeriod(p, btn){
  STATE.period=p;
  document.querySelectorAll('.periodo-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  render();
}

// ── TEMA CLARO/ESCURO ────────────────────────────────────────────────────────
const LS_THEME='repasse_dash_theme';
const ICON_MOON='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';
const ICON_SUN='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>';
function applyTheme(mode){
  const dark = (mode==='dark');
  document.documentElement.setAttribute('data-theme', dark?'dark':'light');
  const b=document.getElementById('themeBtn');
  if(b) b.innerHTML = dark ? ICON_SUN : ICON_MOON;
  try{ localStorage.setItem(LS_THEME, dark?'dark':'light'); }catch(_){}
}
(function(){
  let m='light'; try{ m=localStorage.getItem(LS_THEME)||'light'; }catch(_){}
  applyTheme(m);
  const b=document.getElementById('themeBtn');
  if(b) b.addEventListener('click', function(){
    const cur=document.documentElement.getAttribute('data-theme')==='dark';
    applyTheme(cur?'light':'dark');
  });
})();

// ── INIT ──────────────────────────────────────────────────────────────────────
loadAll();
setInterval(loadAll, 60000);
</script>
</body>
</html>
